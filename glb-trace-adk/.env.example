PROJECT_ID=your-project-id
# Read by both services (same value the k8s manifests inject) to build projects/<id>/traces/<id> in log lines.
GOOGLE_CLOUD_PROJECT=${PROJECT_ID}
REGION=us-central1
ZONE=us-central1-a
CLUSTER_NAME=p1-lb-trace-gke
NETWORK_NAME=p1-lb-trace-vpc
GEMINI_MODEL=gemini-3.8-flash
CLOUDSDK_CONTAINER_USE_APPLICATION_DEFAULT_CREDENTIALS=false
